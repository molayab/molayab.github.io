---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';

const description = "This page doesn't exist — it may have moved, or the link may be mistyped.";
---
<Base
  title={`Page not found — ${SITE.title}`}
  ogTitle="Page not found"
  description={description}
  path="/404.html"
  noindex
>
  <section class="hero">
    <p class="eyebrow">404</p>
    <h1 class="hero-name">Page not found</h1>
    <p class="hero-bio">This page doesn't exist — it may have moved, or the link may be mistyped. Try the <a href="/">homepage</a> or the <a href="/blog/">blog</a>.</p>
  </section>
</Base>
