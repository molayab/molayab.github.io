---
// Page shell: <head> (title, description, canonical, Open Graph, Twitter,
// JSON-LD, feed, analytics), theme toggle, <main> and footer. Used by every page.
import '../styles/index.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import SiteMark from '../components/SiteMark.astro';
import Footer from '../components/Footer.astro';
import { SITE, absoluteUrl } from '../data/site';

interface Props {
  /** Full <title>. */
  title: string;
  /** Title used for og:title / twitter:title / og:image:alt. */
  ogTitle?: string;
  description: string;
  /** Path of this page, e.g. /blog/. Used for canonical and og:url. */
  path: string;
  /** Site-relative or absolute image; defaults to /og-image.png. */
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** article:* meta (posts only). */
  article?: { published: string; modified: string; tags: string[] };
  /** JSON-LD document(s), serialised into one script tag. */
  jsonLd?: object;
  /** Show the fixed monogram link to the homepage (blog pages). */
  siteMark?: boolean;
  footer?: 'home' | 'blog';
}

const {
  title,
  ogTitle = title,
  description,
  path,
  image = SITE.defaultImage,
  type = 'website',
  noindex = false,
  article,
  jsonLd,
  siteMark = true,
  footer = 'blog',
} = Astro.props;

const canonical = absoluteUrl(path);
const imageUrl = absoluteUrl(image);
// "<" is escaped so no value can close the script element.
const ld = jsonLd ? JSON.stringify(jsonLd, null, 2).replace(/</g, '\\u003c') : undefined;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="author" content={SITE.author}>
{!noindex && <link rel="canonical" href={canonical}>}

<!-- Open Graph / social preview -->
<meta property="og:type" content={type}>
<meta property="og:site_name" content={SITE.title}>
<meta property="og:locale" content="en_US">
<meta property="og:url" content={canonical}>
<meta property="og:title" content={ogTitle}>
<meta property="og:description" content={description}>
<meta property="og:image" content={imageUrl}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={ogTitle}>
{article && <meta property="article:published_time" content={article.published}>}
{article && <meta property="article:modified_time" content={article.modified}>}
{article && <meta property="article:author" content={`${SITE.url}/`}>}
{article && article.tags.map((tag) => <meta property="article:tag" content={tag}>)}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content={SITE.twitter}>
<meta name="twitter:creator" content={SITE.twitter}>
<meta name="twitter:title" content={ogTitle}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={imageUrl}>
<meta name="twitter:image:alt" content={ogTitle}>
{noindex && <meta name="robots" content="noindex">}

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<meta name="theme-color" id="themeColorMeta" content={SITE.themeColor.light}>
<link rel="alternate" type="application/atom+xml" title={`${SITE.title} — Blog`} href={absoluteUrl('/feed.xml')}>

<!-- Set the theme before first paint (no flash); the toggle script takes over -->
<script is:inline>
  (function () {
    try {
      var dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      var saved = localStorage.getItem('molayab-theme');
      if (saved) dark = saved === 'dark';
      document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
    } catch (e) {}
  })();
</script>

<!-- Cloudflare Web Analytics --><script is:inline type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "ba7b9836966d428bbebf86d854ae51eb"}'></script><!-- End Cloudflare Web Analytics -->

<!-- Google tag (gtag.js) -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-LNZDWNT4BV"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-LNZDWNT4BV');
</script>

{ld && <script is:inline type="application/ld+json" set:html={ld}></script>}
</head>
<body>

{siteMark && <SiteMark />}

<!-- Theme toggle -->
<ThemeToggle />

<main class="page">
<slot />

<Footer variant={footer} />
</main>
</body>
</html>
